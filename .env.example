# SPIDEY configuration — copy to .env and fill in (never commit .env)
SPIDEY_PROVIDER=rule_based
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
API_HOST=127.0.0.1
API_PORT=8000
# Phase 2+ (PostgreSQL + pgvector, see docker-compose.yml)
DATABASE_URL=postgresql+psycopg://spidey:spidey@localhost:5432/spidey
